MONGODB_URI=
MONGODB_DB_NAME=

# Storage (Phase 7)
# Leave CLOUDINARY_* empty to use the local filesystem adapter (./uploads).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: secret used to sign local/private file URLs (falls back to
# CLOUDINARY_API_SECRET, then a dev-only default outside production).
STORAGE_SIGNING_SECRET=
# Optional: override the local storage root (defaults to ./uploads).
LOCAL_STORAGE_DIR=
