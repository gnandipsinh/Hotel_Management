# ==============================================================================
# HOTELHUB HOTEL MANAGEMENT SAAS — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# Only variables required by currently implemented phases should be configured.
# Future-phase variables must remain blank until their respective phases.
# NEVER commit secrets, credentials, or private keys to version control.
# ==============================================================================

# ==============================================================================
# 1. CURRENT CONFIGURATION (Phases 1, 6 & 7)
# ==============================================================================

# Database — MongoDB Atlas & Mongoose Connection
MONGODB_URI=
MONGODB_DB_NAME=hotel_saas

# Local Storage Provider (Development Fallback)
LOCAL_STORAGE_DIR=.storage
STORAGE_SIGNING_SECRET=

# Cloud Storage Provider — Cloudinary (Optional, active when keys are provided)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==============================================================================
# 2. FUTURE CONFIGURATION (ROADMAP PHASES)
# ==============================================================================

# Future Application URL
NEXT_PUBLIC_APP_URL=

# Future Authentication (Phase 11 — Real Authentication)
AUTH_SECRET=
AUTH_SESSION_COOKIE_NAME=

# Future Email (Phase 44 — Notifications & Alerts)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=

# Future Payments (Phase 39 — Payments & Folios)
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_KEY_SECRET=

# Future UPI (Phase 39 — Payments + UPI/QR)
UPI_MERCHANT_VPA=
UPI_MERCHANT_NAME=

# Future External Integrations (Phases 43 & 44 — OTA & SMS Gateways)
OTA_WEBHOOK_SECRET=
SMS_GATEWAY_API_KEY=

# Future AI Assistant (Phase 41 — AI Hotel Assistant, Server-side Only)
GEMINI_API_KEY=